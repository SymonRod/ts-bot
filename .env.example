# Copia in `.env` e compila (`.env` è gitignored: password e identità restano locali).
# Usato da docker-compose.yml e docker-compose.example.yml.

# Server TeamSpeak (host o host:porta, default 9987 se omessa). OBBLIGATORIO.
TS_SERVER=voce.example.com:9987

# Nickname del bot.
TS_NICKNAME=MusicBot

# Canale iniziale da joinare (nome o ID). Vuoto = nessun join automatico.
TS_CHANNEL=

# Password del server. Vuota se non richiesta.
TS_PASSWORD=

# Prefisso comandi in chat.
TS_PREFIX=!

# !video (TeamSpeak 6): altezza del video (default 480) e bitrate in kbit/s
# per viewer (default 800). Ogni viewer riceve una copia dal bot: con 5 viewer
# a 800 kbit/s servono ~4 Mbit/s in upload.
TS_VIDEO_HEIGHT=
TS_VIDEO_BITRATE=
# IP locale per WebRTC (es. 192.168.1.10:0). Vuoto = tutte le interfacce.
# Utile sugli host Docker: le interfacce dei bridge rallentano la connessione.
TS_VIDEO_BIND=

# Livello log (error, warn, info, debug, trace).
RUST_LOG=info
